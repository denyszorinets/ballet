# syntax=docker/dockerfile:1
# A general-purpose image for agent runs (the Docker backend starts one
# container per stage session from the project's execution image):
# git, Claude Code and common build tools. Projects needing more extend it.
#   docker build -f deploy/agent/Containerfile -t ballet-agent deploy/agent
FROM node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates curl make jq ripgrep python3 && \
    rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force
# Each session runs in a throwaway container: Claude Code may skip its
# permission prompts (ADR-0023).
ENV IS_SANDBOX=1
WORKDIR /workspace
