{
  "realm": "ballet",
  "displayName": "Ballet (development)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "groups": [
    { "name": "ballet-admins" },
    { "name": "acme-devs" },
    { "name": "acme-viewers" }
  ],
  "clients": [
    {
      "clientId": "ballet-web",
      "name": "Ballet web UI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["basic", "profile", "email", "roles", "web-origins"],
      "protocolMappers": [
        {
          "name": "audience-ballet",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ballet",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@ballet.test",
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "groups": ["ballet-admins"]
    },
    {
      "username": "bob",
      "email": "bob@acme.test",
      "firstName": "Bob",
      "lastName": "Developer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "groups": ["acme-devs"]
    },
    {
      "username": "carol",
      "email": "carol@acme.test",
      "firstName": "Carol",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "groups": ["acme-viewers"]
    }
  ]
}
